{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "id": "/",
  "name": "Kasir Cetak Struk - Token, Transfer, QRIS & Toko",
  "short_name": "Cetak Struk",
  "description": "Aplikasi kasir cetak struk thermal Bluetooth universal untuk Token PLN, Transfer Bank, QRIS Pay, dan Toko Retail.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#ffffff",
  "theme_color": "#4338ca",
  "lang": "id-ID",
  "dir": "ltr",
  "categories": ["business", "finance", "utilities", "productivity"],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/pwa-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa-maskable-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Cetak Token Listrik",
      "short_name": "Token PLN",
      "description": "Buat dan cetak struk pembelian token listrik PLN",
      "url": "/?tab=token",
      "icons": [{ "src": "/pwa-192x192.png", "sizes": "192x192" }]
    },
    {
      "name": "Cetak Transfer Bank",
      "short_name": "Transfer",
      "description": "Cetak struk bukti transfer bank & e-wallet",
      "url": "/?tab=transfer",
      "icons": [{ "src": "/pwa-192x192.png", "sizes": "192x192" }]
    },
    {
      "name": "Cetak Struk QRIS",
      "short_name": "QRIS",
      "description": "Cetak bukti pembayaran QRIS",
      "url": "/?tab=qris",
      "icons": [{ "src": "/pwa-192x192.png", "sizes": "192x192" }]
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "receipt_image",
          "accept": ["image/*", ".jpg", ".jpeg", ".png", ".webp", ".heic"]
        }
      ]
    }
  }
}

